--- a/core/java/android/media/ImageReader.java
+++ b/core/java/android/media/ImageReader.java
@@ -1464,6 +1464,33 @@ public class ImageReader implements AutoCloseable {
     private synchronized native void nativeClose();
     private synchronized native void nativeReleaseImage(Image i);
     private synchronized native Surface nativeGetSurface();
+    // OPLUSCAM-BEGIN
+    // OnePlus camera (Live Photo) extension: hands back the
+    // IGraphicBufferConsumer* behind this ImageReader.  OxygenOS declares exactly
+    //     private synchronized native long nativeGetConsumer()
+    // here; the OOS dump's /system_ext/etc/hidden_api_exemptions whitelists
+    //     Landroid/media/ImageReader;->nativeGetConsumer()J
+    // for the camera app, next to detachImage() and mAcquiredImages (both of
+    // which AOSP already has - this method is the only one missing).
+    //
+    // com.oplus.camera's BufferQueueUtils looks it up by name with
+    // getDeclaredMethod("nativeGetConsumer") + setAccessible(true), casts the
+    // result to Long, and feeds it to
+    //     HardwareBufferUtils.generateAddress(J, HardwareBuffer)
+    // to attach a preview frame to this reader's BufferQueue.
+    //
+    // Without it every preview frame throws NoSuchMethodException,
+    // LivePhotoPresenter.attachImageBufferToBufferQueue() fails, and the
+    // HardwareBuffer taken for that frame is never closed - leaking one
+    // 1920x1440 NV12 gralloc buffer (4200 kB) plus its 72 kB metadata buffer
+    // per frame, ~96 MB/s.  Memory is gone in ~60 s, and lmkd then walks the
+    // whole adj range and kills the foreground camera (dumpsys activity
+    // exit-info reason=3 LOW_MEMORY).  Live Photo itself still worked via a
+    // fallback copy path - it wrote real MotionPhoto JPEGs - so the leak was
+    // the only visible symptom.  See docs/FINDINGS.md #5 in oplus-camera-waffle.
+    @android.compat.annotation.UnsupportedAppUsage
+    private synchronized native long nativeGetConsumer();
+    // OPLUSCAM-END
     private synchronized native int nativeDetachImage(Image i, boolean throwISEOnly);
     private synchronized native void nativeDiscardFreeBuffers();
 
diff --git a/core/jni/android_media_ImageReader.cpp b/core/jni/android_media_ImageReader.cpp
