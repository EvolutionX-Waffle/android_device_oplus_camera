--- a/core/jni/android_media_ImageReader.cpp
+++ b/core/jni/android_media_ImageReader.cpp
@@ -1043,6 +1043,56 @@ static jobject Image_getOplusHardwareBuffer(JNIEnv* env, jobject thiz) {
 }
 #endif
 
+// OPLUSCAM-BEGIN
+// Backs ImageReader.nativeGetConsumer(), the OxygenOS hidden method that
+// com.oplus.camera's Live Photo path reflects for.  It must return the
+// IGraphicBufferConsumer* - the BufferQueueConsumer behind this reader - NOT
+// the BufferItemConsumer* (a ConsumerBase wrapper) and NOT the producer.
+//
+// Proof, from the blob rather than from guessing (docs/FINDINGS.md #5):
+//   * The value ends up as `this` in libNativeWinBuffExchange.so's
+//     attachHardwareBufferToBufferQ(), which makes two virtual calls on it:
+//         ldr x8,[x8,#0x40]; blr   (this, int* outSlot, const sp<GraphicBuffer>&)
+//         ldr x8,[x8,#0x48]; blr   (this, slot, 0, 0, 0, const sp<Fence>&)
+//     and its own error strings name them: "Cannot attachBuffer to
+//     aNativeBufferConsumer" / "Cannot releaseHelper/releaseBuffer to camera
+//     IGraphicBufferConsumer".
+//   * IGraphicBufferConsumer derives from RefBase non-virtually, so its
+//     address point is vtable+0x10 and slots 8/9 are attachBuffer and
+//     releaseBuffer(int, uint64_t, EGLDisplay, EGLSyncKHR, const sp<Fence>&)
+//     - in OxygenOS's libgui AND in ours (dumped from the relocations of
+//     both; the layouts are identical at every slot the blob touches).
+//   * BufferItemConsumer* (session 5/6) lands those slots on unrelated
+//     ConsumerBase virtuals: no crash, no error, buffer never re-attached ->
+//     one gralloc buffer leaked per preview frame (~33 dmabuf fd/s).
+//   * IGraphicBufferProducer* (session 7) has a virtual RefBase base
+//     (address point +0x18), so slot 8 is setAsyncMode and slot 9 is
+//     dequeueBuffer -> SIGSEGV writing through a garbage outBufferAge.
+//
+// The raw pointer is safe to hand out: the BufferQueueConsumer is owned by
+// the BufferItemConsumer, which this context holds for its whole lifetime,
+// and the app only ever passes it straight back into the blob.
+
+static jlong ImageReader_getConsumer(JNIEnv* env, jobject thiz) {
+    ALOGV("%s: ", __FUNCTION__);
+    JNIImageReaderContext* const ctx = ImageReader_getContext(env, thiz);
+    if (ctx == NULL) {
+        jniThrowRuntimeException(env, "ImageReaderContext is not initialized");
+        return 0;
+    }
+    BufferItemConsumer* const consumer = ctx->getBufferConsumer();
+    if (consumer == NULL) {
+        return 0;
+    }
+    // ConsumerBase marks this accessor deprecated ("temporary hack for
+    // refactoring"); it is exactly the object the OxygenOS blob expects.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return reinterpret_cast<jlong>(consumer->getIGraphicBufferConsumer().get());
+#pragma clang diagnostic pop
+}
+
+// OPLUSCAM-END
 } // extern "C"
 
 // ----------------------------------------------------------------------------
